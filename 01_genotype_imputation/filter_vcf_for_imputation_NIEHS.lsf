#!/bin/bash
#BSUB -q long
#BSUB -n 4
#BSUB -M 64
#BSUB -R "rusage[mem=64]"
#BSUB -W 25:00
#BSUB -o /rsrch5/home/epi/stbresnahan/scratch/Placenta_QTL/logs
#BSUB -e /rsrch5/home/epi/stbresnahan/scratch/Placenta_QTL/logs

source /etc/profile.d/modules.sh
module load bcftools

basename=NIEHS_RICHS

input_vcf=/rsrch5/home/epi/bhattacharya_lab/data/mapqtl/NIEHS_RICHS/genotypes/RICHS_genotypes_snps_hg38_dedup.vcf.gz
output_dir=/rsrch5/home/epi/bhattacharya_lab/data/mapqtl/NIEHS_RICHS/genotypes/imputation_ready/${basename}
ref_fasta=/rsrch5/home/epi/bhattacharya_lab/data/GenomicReferences/genome/GCA_000001405.15_GRCh38_no_alt_analysis_set_cleaned_ready_for_salmon.fasta

mkdir -p "$output_dir"

tabix -p vcf $input_vcf

# Step 1: Basic QC filters
# - Remove indels (keep SNPs only for imputation scaffold)
# - Remove multiallelic sites
# - Filter on genotype missingness, MAF, and HWE
bcftools view \
    --type snps \
    --max-alleles 2 \
    --min-alleles 2 \
    "$input_vcf" | \
bcftools filter \
    --exclude 'F_MISSING > 0.05 || MAF < 0.01' | \
bcftools +fill-tags -- -t HWE | \
bcftools filter \
    --exclude 'HWE < 1e-6' | \
# Step 2: Normalize (left-align and trim) against reference genome
bcftools norm \
    --fasta-ref "$ref_fasta" \
    --check-ref w \
    -o "$output_dir/${basename}_filtered_norm.vcf.gz" \
    -O z

bcftools index --tbi "$output_dir/${basename}_filtered_norm.vcf.gz"

# Step 3: Split by chromosome and sort (TOPMed requires per-chromosome VCFs)
for CHR in {1..22}; do
    bcftools view \
        --regions "chr${CHR}" \
        "$output_dir/${basename}_filtered_norm.vcf.gz" | \
    bcftools sort \
        -o "$output_dir/${basename}_chr${CHR}.vcf.gz" \
        -O z
    bcftools index --tbi "$output_dir/${basename}_chr${CHR}.vcf.gz"
done